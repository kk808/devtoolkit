{
  "manifest_version": 3,
  "name": "DevToolkit",
  "version": "0.1.0",
  "description": "A collection of coding and developer tools for your browser.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "activeTab", "scripting", "tabs", "storage", "downloads"],
  "optional_host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "commands": {
    "snapshot-dom": {
      "suggested_key": { "default": "Alt+1" },
      "description": "Snapshot the current page DOM"
    },
    "download-page": {
      "suggested_key": { "default": "Alt+2" },
      "description": "Download the current page DOM snapshot"
    }
  },
  "action": {
    "default_title": "DevToolkit",
    "default_icon": { "16": "icons/panel-16.png", "32": "icons/panel-32.png" }
  },
  "icons": {
    "16": "icons/panel-16.png",
    "32": "icons/panel-32.png",
    "48": "icons/panel-48.png",
    "128": "icons/panel-128.png"
  },
  "side_panel": { "default_path": "devtoolkit.html" }
}
