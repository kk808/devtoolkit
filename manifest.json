{
  "manifest_version": 3,
  "name": "Devtool Side Panel",
  "version": "0.1.0",
  "description": "Toggle a companion panel beside your current tab.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "activeTab", "scripting", "tabs"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "commands": {
    "snapshot-dom": {
      "suggested_key": { "default": "Alt+1" },
      "description": "Snapshot DOM while the Devtool panel is open"
    }
  },
  "action": {
    "default_title": "Toggle Devtool panel",
    "default_icon": { "16": "icons/panel-16.png", "32": "icons/panel-32.png" }
  },
  "icons": {
    "16": "icons/panel-16.png",
    "32": "icons/panel-32.png",
    "48": "icons/panel-48.png",
    "128": "icons/panel-128.png"
  },
  "side_panel": { "default_path": "sidepanel.html" }
}
